generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// # Міграція:
// npx prisma migrate dev --name unified_services_v4
// npx prisma generate

// ═══════════════════════════════════════════════════════
// 1. ENUMS
// ═══════════════════════════════════════════════════════

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum ExperienceLevel {
  LT_1
  Y_1_2
  Y_3_5
  Y_5_10
  Y_10_PLUS
}

enum OrderSource {
  DIRECT
  GIG_PURCHASE
  JOB_PROPOSAL
}

enum OrderStatus {
  NEGOTIATING
  ACCEPTED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OrderEventType {
  CREATED
  ACCEPTED
  DELIVERED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
  AUTO_COMPLETED
  DISPUTED
}

enum JobStatus {
  OPEN
  CLOSED
  EXPIRED
  CANCELLED
}

enum JobBudgetType {
  FIXED
  RANGE
  NEGOTIABLE
}

enum ProposalStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ─── НОВЕ: формат послуги (де і як виконується) ───
enum ServiceFormat {
  ONLINE     // повністю віддалено: логотип, копірайтинг, переклад, консультація
  OFFLINE    // в офісі/салоні майстра: стрижка, манікюр, масаж, ремонт техніки в сервісі
  VISIT      // майстер їде до клієнта: сантехнік, електрик, прибирання, фотограф на свято
  HYBRID     // онлайн консультація + офлайн виконання (дизайнер інтер'єру, юрист)
}

// ─── Старий ServiceType залишаємо для Job (мала зворотна сумісність) ───
enum ServiceType {
  ONLINE
  OFFLINE
  VISIT
  ANY
}

// ─── НОВЕ: тип ціни ───
enum PriceType {
  FIXED        // фіксована: 500 ₴
  FROM         // від 500 ₴ (мінімум, точна — за домовленістю)
  HOURLY       // 300 ₴/година
  NEGOTIABLE   // договірна
}

// ─── НОВЕ: терміновість заявки ───
enum Urgency {
  ASAP         // негайно (терміновий ремонт, аварія)
  TODAY        // сьогодні
  THIS_WEEK    // цього тижня
  FLEXIBLE     // не горить, можу почекати
}

enum MessageType {
  TEXT
  PHOTO
  FILE
  SYSTEM
}

enum TxType {
  TOPUP
  LEAD_FEE
  GIG_COMMISSION
  REFUND
  WITHDRAWAL
  ADJUSTMENT
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum GigStatus {
  DRAFT
  ACTIVE
  PAUSED
  REJECTED
  ARCHIVED
}

enum GigPackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum ReviewDirection {
  CLIENT_TO_FREELANCER
  FREELANCER_TO_CLIENT
}

enum CategoryStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ─── НОВЕ: домен категорії (онлайн/офлайн/обидва) ───
enum CategoryDomain {
  ONLINE_ONLY     // тільки онлайн: Розробка, Тексти, SMM
  OFFLINE_ONLY    // тільки офлайн: Сантехніка, Електрика, Прибирання, Краса
  BOTH            // обидва: Дизайн (логотип онлайн, оформлення кафе офлайн), Фото
}

enum CityStatus {
  ACTIVE
  INACTIVE
}

// ═══════════════════════════════════════════════════════
// 2. КОРИСТУВАЧІ
// ═══════════════════════════════════════════════════════

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  emailVerified Boolean @default(false)
  name          String?
  username      String? @unique

  bio   String?
  phone String?
  city  String?

  avatar                   String?
  avatarPublicId           String?
  banner                   String?
  bannerPublicId           String?
  portfolioImages          String[] @default([])
  portfolioImagesPublicIds String[] @default([])

  verificationStatus       VerificationStatus @default(NONE)
  verificationRejectReason String?
  verifiedAt               DateTime?

  role     Role     @default(CLIENT)
  isOnline Boolean  @default(false)
  lastSeen DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientAvgRating    Float @default(0)
  clientReviewsCount Int   @default(0)

  gigs                 Gig[]
  orders               Order[]            @relation("ClientOrders")
  freelancerOrders     Order[]            @relation("FreelancerOrders")
  jobs                 Job[]              @relation("ClientJobs")
  proposals            Proposal[]         @relation("FreelancerProposals")
  reviews              Review[]           @relation("AuthorReviews")
  sentMessages         Message[]          @relation("SentMessages")
  chats                ChatMember[]
  sessions             Session[]
  accounts             Account[]
  wallet               Wallet?
  orderEvents          OrderEvent[]
  freelancerProfile    FreelancerProfile?
  following            Follow[]           @relation("Following")
  followers            Follow[]           @relation("Followers")
  notifications        Notification[]
  phoneRevealsMade     PhoneReveal[]      @relation("PhoneRevealsByViewer")
  phoneRevealsReceived PhoneReveal[]      @relation("PhoneRevealsOfTarget")

  @@index([username])
  @@index([verificationStatus])
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FreelancerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories String[]          @default([])
  subcategory String?
  skills     FreelancerSkill[]
  experience ExperienceLevel?
  languages  String[]          @default([])

  hourlyRate   Int?
  portfolioUrl String?

  // ─── НОВЕ: географія роботи ───
  primaryCity     String?   // основне місто (slug)
  serviceCities   String[]  @default([])  // інші міста де працює
  willTravel      Boolean   @default(false) // готовий до виїзду
  travelRadiusKm  Int?      // на яку відстань готовий їхати (км)
  travelFeeCents  Int?      // плата за виїзд (опційно)

  // ─── НОВЕ: формати в яких працює ───
  worksOnline   Boolean @default(true)   // приймає онлайн-замовлення
  worksOffline  Boolean @default(false)  // приймає у себе
  worksOnSite   Boolean @default(false)  // їде до клієнта

  // ─── НОВЕ: розклад роботи (JSON для гнучкості) ───
  // Формат: { "mon": "09:00-18:00", "tue": "09:00-18:00", "sat": "off", ... }
  workingHours Json?

  // ─── НОВЕ: чи доступний приймати замовлення зараз ───
  // (toggle "Зайнятий до X числа" / "Доступний")
  isAvailable    Boolean   @default(true)
  unavailableUntil DateTime?

  // Денормалізовані метрики
  avgRating        Float @default(0)
  reviewsCount     Int   @default(0)
  totalOrders      Int   @default(0)
  completedOrders  Int   @default(0)
  responseTimeHrs  Int?
  repeatClientsPct Int   @default(0)
  followers        Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([avgRating])
  @@index([hourlyRate])
  @@index([primaryCity])
  @@index([isAvailable])
  @@index([subcategory]) 
}

// ═══════════════════════════════════════════════════════
// 3. ПОСЛУГИ (Gig — у UI "Послуга")
// ═══════════════════════════════════════════════════════

model Gig {
  id String @id @default(cuid())

  title            String
  slug             String  @unique
  description      String  @db.Text
  shortDescription String? @db.VarChar(280)

  category    String
  subcategory String?
  tags        String[] @default([])

  images          String[] @default([])
  imagesPublicIds String[] @default([])
  videoUrl        String?

  // ─── НОВЕ: формат послуги ───
  format ServiceFormat @default(ONLINE)

  // ─── НОВЕ: ціна (для офлайн послуг — простіша модель ніж packages) ───
  priceType   PriceType @default(FIXED)
  priceCents  Int?      // для FIXED, FROM, HOURLY
  currency    String    @default("UAH")

  // ─── НОВЕ: тривалість (важливо для офлайн: "стрижка 30 хв") ───
  durationMinutes Int?

  // ─── НОВЕ: географія (для OFFLINE/VISIT) ───
  // Майстер каже "я працюю у Києві і Києво-Святошинському районі"
  city          String?    // основне місто (slug City)
  serviceCities String[] @default([])  // інші міста де надається послуга
  travelFeeCents Int?     // окрема плата за виїзд (поверх priceCents)

  status   GigStatus @default(DRAFT)
  isActive Boolean   @default(false)

  viewCount    Int   @default(0)
  ordersCount  Int   @default(0)
  avgRating    Float @default(0)
  reviewsCount Int   @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  sellerId String
  seller   User         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  packages GigPackage[]
  orders   Order[]
  reviews  Review[]

  @@index([category])
  @@index([sellerId])
  @@index([status])
  @@index([slug])
  @@index([avgRating])
  @@index([ordersCount])
  @@index([format])
  @@index([city])
  @@index([format, city, status])
}

model GigPackage {
  id    String @id @default(cuid())
  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)

  tier GigPackageTier

  name        String  @default("")
  description String? @db.Text

  priceCents Int

  deliveryDays Int
  revisions    Int      @default(1)
  features     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gigId, tier])
  @@index([gigId])
}

// ═══════════════════════════════════════════════════════
// 4. ЗАМОВЛЕННЯ
// ═══════════════════════════════════════════════════════

model Order {
  id String @id @default(cuid())

  clientId     String
  client       User   @relation("ClientOrders", fields: [clientId], references: [id])
  freelancerId String
  freelancer   User   @relation("FreelancerOrders", fields: [freelancerId], references: [id])

  gigId  String?
  gig    Gig?        @relation(fields: [gigId], references: [id])
  source OrderSource @default(DIRECT)

  title        String
  description  String    @db.Text
  priceCents   Int
  currency     String    @default("UAH")
  deliveryDays Int?
  deadlineAt   DateTime?

  // ─── НОВЕ: формат і географія (для офлайн замовлень) ───
  format       ServiceFormat?
  city         String?
  // Адреса видна лише після ACCEPTED — захист приватності клієнта
  address      String?
  // Точна дата/час зустрічі (для виїзних)
  scheduledFor DateTime?

  status OrderStatus @default(NEGOTIATING)

  acceptedAt    DateTime?
  deliveredAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?   @db.Text

  deliverables String[] @default([])
  deliveryNote String?  @db.Text

  chatId String?
  chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  leadFeeCents Int @default(0)

  autoCompleteAt DateTime?

  reviews Review[]
  events  OrderEvent[]
  fromJob Job?         @relation("JobToOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([freelancerId, status])
  @@index([chatId])
  @@index([status, createdAt])
  @@index([scheduledFor])
}

model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type    OrderEventType
  actorId String?
  actor   User?          @relation(fields: [actorId], references: [id])
  payload Json?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ═══════════════════════════════════════════════════════
// 5. ЗАЯВКИ КЛІЄНТІВ — головна фішка платформи
// ═══════════════════════════════════════════════════════

model Job {
  id String @id @default(cuid())

  title       String
  description String   @db.Text
  category    String
  subcategory String?
  tags        String[] @default([])

  budgetType     JobBudgetType @default(FIXED)
  budgetMinCents Int?
  budgetMaxCents Int?
  currency       String        @default("UAH")

  deliveryDays Int?
  deadlineAt   DateTime?
  expiresAt    DateTime

  // ─── ЗМІНА: явний формат замість type ───
  // type залишаємо для зворотної сумісності
  type ServiceType @default(ANY)

  // ─── НОВЕ: формат послуги (більш чітко) ───
  format ServiceFormat? // null = клієнту байдуже, підійдуть всі

  city String?

  // ─── НОВЕ: точна адреса (приватна, видима тільки прийнятому майстру) ───
  address String?

  // ─── НОВЕ: терміновість ───
  urgency Urgency @default(FLEXIBLE)

  // ─── НОВЕ: бажаний час виконання (опційно) ───
  scheduledFor DateTime?

  // ─── НОВЕ: фото проблеми (важливо для офлайн: фото зламаної техніки) ───
  attachments          String[] @default([])
  attachmentsPublicIds String[] @default([])

  status JobStatus @default(OPEN)

  proposalsCount Int @default(0)
  viewsCount     Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  clientId String
  client   User   @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)

  proposals Proposal[]

  selectedOrderId String? @unique
  selectedOrder   Order?  @relation("JobToOrder", fields: [selectedOrderId], references: [id])

  @@index([status, createdAt])
  @@index([category])
  @@index([clientId])
  @@index([expiresAt])
  @@index([format])
  @@index([city])
  @@index([format, city, status])
  @@index([urgency, status])
}

model Proposal {
  id String @id @default(cuid())

  jobId        String
  job          Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User   @relation("FreelancerProposals", fields: [freelancerId], references: [id], onDelete: Cascade)

  coverLetter        String @db.Text
  proposedPriceCents Int
  proposedDays       Int

  status ProposalStatus @default(SUBMITTED)

  leadFeeCents Int     @default(0)
  refunded     Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  withdrawnAt DateTime?

  @@unique([jobId, freelancerId])
  @@index([jobId, status])
  @@index([freelancerId, status])
}

// ═══════════════════════════════════════════════════════
// 6. ГАМАНЕЦЬ
// ═══════════════════════════════════════════════════════

model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balanceCents Int    @default(0)
  heldCents    Int    @default(0)
  currency     String @default("UAH")

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amountCents Int
  type        TxType
  description String?

  orderId    String?
  proposalId String?

  externalRef String? @unique

  status TxStatus @default(SUCCESS)

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([proposalId])
}

// ═══════════════════════════════════════════════════════
// 7. ВІДГУКИ
// ═══════════════════════════════════════════════════════

model Review {
  id      String  @id @default(cuid())
  rating  Int
  comment String?

  direction ReviewDirection

  gigId String?
  gig   Gig?    @relation(fields: [gigId], references: [id])

  authorId String
  author   User   @relation("AuthorReviews", fields: [authorId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, direction])
  @@index([gigId])
  @@index([authorId])
  @@index([rating])
  @@index([direction])
}

// ═══════════════════════════════════════════════════════
// 8. ЧАТИ І ПОВІДОМЛЕННЯ
// ═══════════════════════════════════════════════════════

model Chat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastMessageText String?
  lastMessageAt   DateTime?
  lastSenderId    String?

  members  ChatMember[]
  messages Message[]
  orders   Order[]

  @@index([updatedAt])
  @@index([lastMessageAt])
}

model ChatMember {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?
  mutedUntil DateTime?

  createdAt DateTime @default(now())

  @@unique([chatId, userId])
  @@index([userId])
  @@index([chatId])
}

model Message {
  id   String      @id @default(cuid())
  type MessageType @default(TEXT)
  text String      @default("")

  attachmentUrl      String?
  attachmentPublicId String?
  attachmentMimeType String?
  attachmentSize     Int?
  attachmentName     String?

  isRead    Boolean   @default(false)
  editedAt  DateTime?
  deletedAt DateTime?

  chatId   String
  chat     Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  replyToId String?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([senderId])
}

// ═══════════════════════════════════════════════════════
// 9. КАТЕГОРІЇ
// ═══════════════════════════════════════════════════════

model Category {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?        @db.Text
  icon        String?
  color       String?
  status      CategoryStatus @default(ACTIVE)

  // ─── НОВЕ: домен (онлайн/офлайн/обидва) ───
  // Впливає на UI: показуємо чи приховуємо фільтр "місто"
  domain CategoryDomain @default(BOTH)

  sortOrder Int @default(0)

  seoTitle       String?
  seoDescription String?

  gigsCount        Int @default(0)
  jobsCount        Int @default(0)
  freelancersCount Int @default(0)

  subcategories Subcategory[]
  skills        Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([domain])
}

model Subcategory {
  id          String         @id @default(cuid())
  slug        String
  name        String
  description String?        @db.Text
  icon        String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)

  // ─── НОВЕ: домен підкатегорії може відрізнятись від батьківської ───
  // Наприклад: Дизайн (BOTH) → Веб-дизайн (ONLINE_ONLY), Оформлення інтерʼєру (OFFLINE_ONLY)
  domain CategoryDomain?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  services Service[]

  seoTitle       String?
  seoDescription String?

  gigsCount Int @default(0)
  jobsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([status, sortOrder])
  @@index([categoryId])
  @@index([domain])
}

model Service {
  id          String         @id @default(cuid())
  slug        String
  name        String
  description String?        @db.Text
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)

  avgPriceCents Int?

  // ─── НОВЕ: типовий формат для цієї довідкової послуги ───
  // Допомагає UI підказати майстру при створенні Gig: "Цю послугу зазвичай надають онлайн"
  typicalFormat ServiceFormat?

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  seoTitle       String?
  seoDescription String?

  gigsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subcategoryId, slug])
  @@index([status, sortOrder])
  @@index([subcategoryId])
}

// ═══════════════════════════════════════════════════════
// 10. BETTER-AUTH
// ═══════════════════════════════════════════════════════

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId   String
  accountId    String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@index([identifier])
}

// ═══════════════════════════════════════════════════════
// 11. МІСТА
// ═══════════════════════════════════════════════════════

model City {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  region    String?
  isCapital Boolean    @default(false)
  sortOrder Int        @default(0)
  status    CityStatus @default(ACTIVE)

  // ─── НОВЕ: координати для радіусу пошуку ───
  // Майстер каже "їжджу в радіусі 15 км від Києва" — рахуємо за цими координатами
  latitude  Float?
  longitude Float?

  // ─── НОВЕ: денормалізовані лічильники для UI ───
  freelancersCount Int @default(0)
  jobsCount        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@index([sortOrder])
  @@index([status, sortOrder])
}

// ═══════════════════════════════════════════════════════
// 12. НАВИЧКИ
// ═══════════════════════════════════════════════════════

model Skill {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  freelancers FreelancerSkill[]

  @@index([categoryId])
  @@index([sortOrder])
}

model FreelancerSkill {
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId String

  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId String

  createdAt DateTime @default(now())

  @@id([freelancerId, skillId])
  @@index([skillId])
  @@index([freelancerId])
}

// ═══════════════════════════════════════════════════════
// 13. ІНШЕ
// ═══════════════════════════════════════════════════════

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String
  title String
  body  String?

  orderId    String?
  proposalId String?
  jobId      String?
  chatId     String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model PhoneReveal {
  id String @id @default(cuid())

  viewerId String
  viewer   User   @relation("PhoneRevealsByViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  targetId String
  target   User   @relation("PhoneRevealsOfTarget", fields: [targetId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String? @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([viewerId, createdAt])
  @@index([viewerId, targetId])
  @@index([targetId, createdAt])
}